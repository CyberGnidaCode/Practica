resharper_style_cop_sa1008_highlighting = hint
resharper_style_cop_sa1623_highlighting = none
resharper_style_cop_sa1625_highlighting = hint
resharper_style_cop_sa1630_highlighting = hint
resharper_style_cop_sa1631_highlighting = suggestion
resharper_style_cop_sa1633_highlighting = none
resharper_style_cop_sa1642_highlighting = none
resharper_suggest_var_or_type_built_in_types_highlighting = hint
resharper_suggest_var_or_type_elsewhere_highlighting = hint
